  return `<section class="screen"><div class="wrap">
    <div class="screen-head"><div style="display:flex; align-items:center; gap:10px;"><span class="icon-chip chip-teal">${TAB_ICONS.recupera}</span><div><h1>Recupera</h1><div class="muted">Movilidad y descarga, 10-12 min</div></div></div></div>
    <div class="card"><div class="row"><span>Molestias de rodilla esta semana</span><span class="v">${kneeHits}x</span></div><div class="row"><span>Molestias de pie esta semana</span><span class="v">${footHits}x</span></div></div>
    <div class="card">
      <ol class="recov-list">${RECUPERACION_ITEMS.map(it=>`<li>${it}</li>`).join('')}</ol>
      <button class="btn-primary" style="background:var(--teal);" onclick="startDraftFromPreset('mov')">Registrar movilidad · ${fmtNum(kcal)} kcal</button>
      <div class="muted" style="margin-top:10px;">Entrenas hasta tarde: esta rutina también baja pulsaciones y ayuda a conciliar el sueño después de la adrenalina del partido/entreno.</div>
    </div>
  </div></section>`;
}

function renderFoodLog(){
  const n=nutritionTargets();
  const consumed=todayFoodKcal(), consumedProtein=todayFoodProtein();
  const pct=clamp((consumed/n.dailyTarget)*100,0,140);
  const entries=todayFoodEntries();
  const rows = entries.length ? entries.map(f=>`<div class="hist-item"><div><div>${escapeHtml(f.label)}</div><div class="meta">${fmtNum(f.kcal)} kcal${f.proteinG?` · ${f.proteinG}g prot`:''}</div></div><button class="del" onclick="deleteFoodEntry('${f.id}')">🗑</button></div>`).join('') : `<div class="muted">Aún no has registrado comidas hoy.</div>`;
  return `<div class="card">
    <h2 class="section-title" style="margin-top:0;">Calorías ingeridas hoy</h2>
    <div class="row"><span>Consumidas</span><span class="v">${fmtNum(consumed)} / ${fmtNum(n.dailyTarget)} kcal</span></div>
    <div class="level-bar" style="margin-bottom:10px;"><div class="level-fill" style="width:${Math.min(pct,100)}%; background:${pct>110?'var(--danger)':'var(--yellow)'};"></div></div>
    <div class="row"><span>Proteína</span><span class="v">${consumedProtein} / ${n.proteinG} g</span></div>
    <div class="field" style="margin-top:12px;"><label>Añadir comida</label>
      <div class="comp-row">
        <input type="text" id="foodLabelInput" placeholder="Qué has comido">
        <input type="number" id="foodKcalInput" placeholder="kcal" style="max-width:76px;">
      </div>
      <div class="comp-row">
        <input type="number" id="foodProteinInput" placeholder="proteína g (opcional)">
        <button class="btn-primary" style="margin-top:0; width:auto; padding:9px 16px; box-shadow:none;" onclick="addCustomFood()">Añadir</button>
      </div>
    </div>
    ${rows}
  </div>`;
}
function renderNutricionTab(){
  const n=nutritionTargets();
  const rateBtns = [0.4,0.6,0.8].map(r=>`<button class="rate-btn ${profile.weeklyRateKg===r?'active':''}" onclick="setRate(${r})">${r} kg/sem</button>`).join('');
  const warn = n.dailyTarget<1600 ? `<div class="notice warn">Objetivo ajustado con este ritmo — sube ingesta el jueves (2h de entreno) y considera bajar el ritmo si cuesta sostenerlo.</div>` : '';
  const mealBlocks = MEALS.map((m,ci)=>`<div class="meal-cat"><h3>${m.cat}</h3>${m.note?`<div class="muted" style="margin-bottom:6px;">${m.note}</div>`:''}${m.items.map((i,ii)=>`<div class="meal-item"><span>${i.name}</span><div style="display:flex; align-items:center; gap:8px;"><span class="meal-tag">${i.kcal} kcal</span><button class="btn-small" style="padding:5px 9px; background:var(--surface-2); border-radius:8px;" onclick="addMealQuick(${ci},${ii})">+</button></div></div>`).join('')}</div>`).join('');
  return `<section class="screen"><div class="wrap">
    <div class="screen-head"><h1>Nutrición</h1><div class="muted">Objetivo, ingesta y comidas de referencia</div></div>
    <div class="card">
      <div class="rate-selector">${rateBtns}</div>
      <div class="row"><span>Objetivo calórico diario</span><span class="v">${fmtNum(n.dailyTarget)} kcal</span></div>
      <div class="row"><span>Proteína</span><span class="v">${n.proteinG} g</span></div>
      <div class="row"><span>Grasa</span><span class="v">${n.fatG} g</span></div>
      <div class="row"><span>Carbohidratos</span><span class="v">${n.carbG} g</span></div>
    </div>
    ${warn}
    ${renderFoodLog()}
    <div class="muted" style="margin-top:10px;">Toca + para registrar directamente una comida de la lista. La pérdida de grasa depende del déficit semanal acumulado, no de las kcal quemadas por sesión.</div>
    <div class="card">${mealBlocks}</div>
  </div></section>`;
}

function renderProgresoTab(){
  const base=baselineDaily(), weekKcal=thisWeekActualKcal(), typicalWeek=typicalWeeklyExerciseKcal(), proj=projection(), iphoneWeek=thisWeekIphoneKcal();
  const pts=totalPoints(), idx=levelIndex(pts), cur=LEVELS[idx], next=LEVELS[idx+1];
  const pct= next? clamp((pts-cur.min)/(next.min-cur.min)*100,0,100):100;
  const badges=computeBadges().map(b=>`<div class="badge ${b.on?'':'locked'}"><div class="badge-label">${b.label}</div><div class="badge-desc">${b.desc}</div></div>`).join('');
  const n=nutritionTargets();
  const items=[...sessions].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,20);
  const histBody = items.length===0 ? `<div class="muted">Aún no hay sesiones registradas.</div>` : items.map(s=>{
    const pain=(s.kneePain>0?`<span class="pain-tag">rodilla ${s.kneePain}</span>`:'')+(s.footPain>0?`<span class="pain-tag">pie ${s.footPain}</span>`:'');
    const iphoneNote = (s.iphoneKcal!=null) ? ` · iPhone: ${fmtNum(s.iphoneKcal)}` : '';
    return `<div class="hist-item"><div><div>${escapeHtml(s.label)}${pain}</div><div class="meta">${fmtDateEs(s.date)}${s.note?' · '+escapeHtml(s.note):''}${iphoneNote}</div></div><div style="text-align:right; display:flex; align-items:center; gap:6px;"><span class="disp" style="font-size:17px; color:var(--orange);">${s.isRestDay?'—':fmtNum(s.totalKcal)}</span><button class="del" onclick="deleteSession('${s.id}')">🗑</button></div></div>`;
  }).join('');
  const metRows = Object.keys(TYPE_META).map(k=>`<div class="met-grid"><label>${TYPE_META[k].icon} ${TYPE_META[k].label} (MET)</label><input type="number" step="0.5" value="${effectiveMet(k)}" onchange="updateMet('${k}', this.value)"></div>`).join('');
  return `<section class="screen"><div class="wrap">
    <div class="screen-head"><h1>Progreso</h1><div class="muted">Nivel, cuerpo y objetivo</div></div>

    <div class="card">
      <div class="level-row"><span class="level-name disp">${cur.name}</span><span class="muted">${fmtNum(pts)} pts${next?` · ${fmtNum(next.min-pts)} para ${next.name}`:' · nivel máximo'}</span></div>
      <div class="level-bar"><div class="level-fill" style="width:${pct}%; background:var(--orange);"></div></div>
      <div class="badge-shelf">${badges}</div>
    </div>

    <div class="card">
      <div class="row"><span>BMR estimado</span><span class="v">${fmtNum(bmr())} kcal/día</span></div>
      <div class="row"><span>Base sin ejercicio</span><span class="v">${fmtNum(base)} kcal/día</span></div>
      <div class="row"><span>· durante el sueño (${profile.sleepHours}h)</span><span class="v">${fmtNum(sleepKcal())} kcal</span></div>
      <div class="row"><span>· despierta${isNoMovementToday()?' (hoy sin movimiento)':''}</span><span class="v">${fmtNum(awakeKcal())} kcal</span></div>
      <div class="row"><span>Quemadas esta semana</span><span class="v">${fmtNum(weekKcal)} kcal</span></div>
      ${iphoneWeek.count>0?`<div class="row"><span>Según iPhone esta semana (${iphoneWeek.count} sesiones)</span><span class="v">${fmtNum(iphoneWeek.total)} kcal</span></div>`:''}
      <div class="row"><span>Semana tipo (5 sesiones fijas)</span><span class="v">${fmtNum(typicalWeek)} kcal</span></div>
      <div class="row"><span>Peso inicial → actual</span><span class="v">${initialWeight()} → ${latestWeight()} kg</span></div>
      <div class="row"><span>Perdido hasta ahora</span><span class="v">${Math.round(proj.lostSoFar*10)/10} kg</span></div>
      <div class="row"><span>Restante hasta -${profile.targetLossKg}kg</span><span class="v">${Math.round(proj.remaining*10)/10} kg</span></div>
      <div class="row"><span>Semanas restantes estimadas</span><span class="v">${proj.weeks} sem · ≈ ${proj.eta}</span></div>
      ${renderWeightChart()}
      <div class="field" style="margin-top:12px;"><label>Peso actual (kg) — registrar nuevo</label><input type="number" step="0.1" placeholder="ej. 75.4" onchange="updateWeight(this.value); this.value=''"></div>
    </div>

    <div class="card">
      <h3 class="disp" style="font-size:16px; margin-bottom:8px;">Recomposición corporal</h3>
      <div class="muted">Con 2 sesiones de fuerza + baloncesto 3x/semana y proteína cubierta (~${n.proteinG} g/día):</div>
      <div class="row"><span>Meses 1–3</span><span class="v">0,1–0,3 kg/mes</span></div>
      <div class="row"><span>A partir del mes 4</span><span class="v">0,05–0,15 kg/mes</span></div>
      <div class="muted" style="margin-top:4px;">Estimación no clínica — solo InBody/DEXA la confirma.</div>
    </div>

    <h2 class="section-title">Historial</h2>
    <div class="card">${histBody}</div>

    <div class="card">
      <details ${settingsOpen?'open':''}>
        <summary onclick="event.preventDefault(); toggleSettings();">Ajustes ${settingsOpen?'▾':'▸'}</summary>
        <div style="margin-top:12px;">
          <div class="field"><label>Edad</label><input type="number" value="${profile.age}" onchange="updateAge(this.value)"></div>
          <div class="field"><label>Altura (cm)</label><input type="number" value="${profile.heightCm}" onchange="updateHeight(this.value)"></div>
          <div class="field"><label>Objetivo de pérdida total (kg)</label><input type="number" value="${profile.targetLossKg}" onchange="updateTargetLoss(this.value)"></div>
          <div class="field"><label>Horas de sueño habituales</label><input type="number" step="0.5" min="3" max="12" value="${profile.sleepHours}" onchange="updateSleepHours(this.value)"></div>
          <div class="settings-row" onclick="toggleSound()"><span>Sonido</span><span class="ios-switch ${profile.soundOn?'on':''}"><span class="knob"></span></span></div>
          <div class="muted" style="margin:8px 0 4px;">MET por actividad (editable):</div>
          ${metRows}
          <button class="btn-ghost" style="margin-top:14px; border-color:var(--danger); color:var(--danger);" onclick="resetAll()">Borrar todos los datos</button>
        </div>
      </details>
    </div>
  </div></section>`;
}

function renderTabbar(){
  const tabs=[{id:'hoy',label:'Hoy'},{id:'entrena',label:'Entrena'},{id:'recupera',label:'Recupera'},{id:'nutricion',label:'Nutrición'},{id:'progreso',label:'Progreso'}];
  return `<nav class="tabbar">${tabs.map(t=>`<button class="tab-btn tab-${t.id} ${activeTab===t.id?'active':''}" onclick="switchTab('${t.id}')"><span class="tab-icon">${TAB_ICONS[t.id]}</span><span class="tab-label">${t.label}</span></button>`).join('')}</nav>`;
}

function renderComposer(){
  if(!draft) return '';
  const w=latestWeight();
  const total = draft.directKcal ? Math.round(draft.directValue||0) : draft.comps.reduce((a,c)=>a+kcalFor(c.type,c.min,w),0);
  const compsHtml = draft.comps.map((c,i)=>`<div class="comp-row"><select onchange="onTypeChange(${i}, this.value)">${Object.keys(TYPE_META).map(k=>`<option value="${k}" ${c.type===k?'selected':''}>${TYPE_META[k].icon} ${TYPE_META[k].label}</option>`).join('')}</select><input type="number" min="0" value="${c.min}" oninput="onMinChange(${i}, this.value)"><button class="rm" onclick="removeCompRow(${i})">×</button></div>`).join('');
  const painRow=(kind,val)=>[0,1,2,3].map(v=>`<button class="pain-btn ${val===v?'active':''}" onclick="setPain('${kind}',${v})">${['Ninguna','Leve','Moderada','Fuerte'][v]}</button>`).join('');
  const activityBlock = draft.directKcal
    ? `<div class="field"><label>Total de kcal (del anillo de Movimiento)</label><input type="number" min="0" placeholder="ej. 620" value="${draft.directValue!=null?draft.directValue:''}" onchange="onDirectValueChange(this.value)"></div>`
    : `<div class="field"><label>Actividades</label>${compsHtml}<button class="btn-ghost" onclick="addCompRow()">+ Añadir actividad</button></div>
    <div class="field"><label>Calorías del iPhone/Watch para hoy (opcional)</label><input type="number" min="0" placeholder="lo que te calcule tu iPhone" value="${draft.iphoneKcal!=null?draft.iphoneKcal:''}" onchange="onIphoneKcalChange(this.value)"></div>`;
  return `<div class="wrap" id="composer"><div class="card"><div class="grabber"></div>
    <h2 class="section-title" style="margin-top:0;">${draft.directKcal ? 'Anillo de Movimiento' : (draft.label ? 'Editar sesión' : 'Nueva sesión')}</h2>
    <div class="field"><label>Fecha</label><input type="date" value="${draft.date}" onchange="onDateChange(this.value)"></div>
    <div class="field"><label>Nombre (opcional)</label><input type="text" value="${escapeHtml(draft.label)}" placeholder="ej. Entreno martes" onchange="onLabelChange(this.value)"></div>
    ${activityBlock}
    <div class="total-kcal" id="draftTotalKcal">${fmtNum(total)} kcal</div>
    <div class="field"><label>Dolor de rodilla (cruzado)</label><div class="pain-group">${painRow('knee', draft.kneePain)}</div></div>
    <div class="field"><label>Dolor de pie (fascitis)</label><div class="pain-group">${painRow('foot', draft.footPain)}</div></div>
    <div class="field"><label>Notas (opcional)</label><textarea onchange="onNoteChange(this.value)">${escapeHtml(draft.note)}</textarea></div>
    <div class="actions"><button class="btn-ghost" onclick="cancelDraft()">Cancelar</button><button class="btn-primary" style="margin-top:0;" onclick="saveDraft()">Guardar sesión</button></div>
  </div></div>`;
}

function renderScreen(){
  if(activeTab==='hoy') return renderHoy();
  if(activeTab==='entrena') return renderEntrena();
  if(activeTab==='recupera') return renderRecupera();
  if(activeTab==='nutricion') return renderNutricionTab();
  return renderProgresoTab();
}
function renderAll(){
  document.getElementById('app').innerHTML = renderScreen() + renderComposer() + renderTabbar();
  checkCelebrations();
  if(activeTab==='hoy') animateRing(currentStreak());
}

(async function init(){ await loadState(); renderAll(); })();
</script>
</body>
</html>
