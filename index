let audioCtx=null;
function ensureAudio(){ if(!audioCtx){ audioCtx = new (window.AudioContext||window.webkitAudioContext)(); } return audioCtx; }
function playTone(freq,dur,type){
  if(!profile.soundOn) return;
  try{ const ctx=ensureAudio(); const osc=ctx.createOscillator(); const gain=ctx.createGain();
    osc.type=type||'sine'; osc.frequency.value=freq;
    gain.gain.setValueAtTime(0.15, ctx.currentTime); gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime+dur);
    osc.connect(gain); gain.connect(ctx.destination); osc.start(); osc.stop(ctx.currentTime+dur);
  }catch(e){}
}
function playSwish(){ playTone(880,0.15,'triangle'); setTimeout(()=>playTone(660,0.12,'triangle'),90); }
function playBuzzer(){ playTone(180,0.6,'sawtooth'); }
function toggleSound(){ profile.soundOn=!profile.soundOn; saveProfile(); if(profile.soundOn) playSwish(); renderAll(); }
function showToast(msg){
  const t=document.createElement('div'); t.className='toast'; t.textContent=msg; document.body.appendChild(t);
  setTimeout(()=>{ t.classList.add('out'); setTimeout(()=>t.remove(),400); }, 2400);
}
function celebrate(){
  const colors=['var(--orange)','var(--blue)','var(--teal)','var(--yellow)'];
  for(let i=0;i<28;i++){
    const p=document.createElement('div'); p.className='confetti-piece'; p.style.background=colors[i%colors.length];
    p.style.left=(Math.random()*100)+'vw'; p.style.animationDuration=(1.3+Math.random()*0.9)+'s'; p.style.animationDelay=(Math.random()*0.3)+'s';
    document.body.appendChild(p); setTimeout(()=>p.remove(), 2200);
  }
  playBuzzer();
}
function checkCelebrations(){
  const idx=levelIndex(totalPoints());
  if(idx>profile.lastLevelIndex){ showToast(`Subiste de nivel: ${LEVELS[idx].name}`); profile.lastLevelIndex=idx; saveProfile(); }
  const streak=currentStreak();
  if(streak>=21 && !profile.celebrated21){ celebrate(); showToast('¡Partido completo! Reto de 21 días superado'); profile.celebrated21=true; saveProfile(); }
  if(streak===0 && profile.celebrated21){ profile.celebrated21=false; saveProfile(); }
}
function computeBadges(){
  const best=bestStreak(), idx=levelIndex(totalPoints()), distinctDays=loggedDatesSet().size, nSessions=sessions.filter(s=>!s.isRestDay).length;
  return [
    {label:'Primeros pasos', desc:'3 días seguidos', on:best>=3},
    {label:'1er cuarto', desc:'5 días seguidos', on:best>=5},
    {label:'Medio tiempo', desc:'10 días seguidos', on:best>=10},
    {label:'3er cuarto', desc:'15 días seguidos', on:best>=15},
    {label:'Partido completo', desc:'21 días seguidos', on:best>=21},
    {label:'Constancia', desc:'10 días registrados', on:distinctDays>=10},
    {label:'Doble figura', desc:'10 sesiones', on:nSessions>=10},
    {label:'Titular', desc:'nivel Titular', on:idx>=2},
    {label:'MVP de barrio', desc:'nivel máximo', on:idx>=4}
  ];
}

