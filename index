function renderRing(streak){
  const r=70, c=2*Math.PI*r, pct=clamp(streak/21,0,1), offset=c*(1-pct);
  const color = 'var(--orange)';
  return `<div class="ring-wrap">
    <svg viewBox="0 0 160 160" class="ring-svg">
      <circle cx="80" cy="80" r="${r}" class="ring-track"/>
      <circle cx="80" cy="80" r="${r}" class="ring-fill" id="ringFill" data-offset="${offset}" style="stroke:${color}; stroke-dasharray:${c}; stroke-dashoffset:${c};"/>
    </svg>
    <div class="ring-center"><div class="ring-num disp" id="ringNumDisplay">0</div><div class="ring-sub">/ 21 días</div></div>
  </div>
  <div class="ring-note">incluye 1 comodín automático si falta un día</div>`;
}
function animateRing(streak){
  const el=document.getElementById('ringFill'), numEl=document.getElementById('ringNumDisplay');
  if(!el) return;
  const target=Number(el.dataset.offset);
  const reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduced){ el.style.strokeDashoffset=target; if(numEl) numEl.textContent=streak; return; }
  requestAnimationFrame(()=>requestAnimationFrame(()=>{ el.style.strokeDashoffset=target; }));
  const start=performance.now(), dur=800;
  function step(now){
    const p=Math.min(1,(now-start)/dur), eased=1-Math.pow(1-p,3);
    if(numEl) numEl.textContent=Math.round(streak*eased);
    if(p<1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function renderWeightChart(){
  const log=profile.weightLog;
  if(log.length<2) return `<div class="muted" style="margin-top:8px;">Registra un par de pesos más para ver la tendencia.</div>`;
  const weights=log.map(l=>l.kg);
  const min=Math.min(...weights), max=Math.max(...weights);
  const pad=(max-min)*0.2 || 1;
  const lo=min-pad, hi=max+pad, w=280, h=76;
  const pts = log.map((l,i)=>{
    const x = (i/(log.length-1))*w;
    const y = h - ((l.kg-lo)/(hi-lo))*h;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });
  const line = pts.join(' ');
  const area = `0,${h} ${line} ${w},${h}`;
  return `<div class="chart-wrap">
    <svg viewBox="0 0 ${w} ${h}" class="chart-svg" preserveAspectRatio="none">
      <defs><linearGradient id="wgrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" style="stop-color:var(--orange); stop-opacity:0.35"/>
        <stop offset="100%" style="stop-color:var(--orange); stop-opacity:0"/>
      </linearGradient></defs>
      <polygon points="${area}" style="fill:url(#wgrad); stroke:none;"/>
      <polyline points="${line}" style="fill:none; stroke:var(--orange); stroke-width:2.5; stroke-linecap:round; stroke-linejoin:round;"/>
    </svg>
    <div class="chart-labels"><span>${log[0].kg} kg · ${fmtDateEs(log[0].date)}</span><span>${log[log.length-1].kg} kg · ${fmtDateEs(log[log.length-1].date)}</span></div>
  </div>`;
}
